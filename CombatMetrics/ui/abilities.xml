<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sir.insidi.at/or/schema/esoui.xsd">
    <Controls>
        <Control name="CombatMetrics_AbilitiesPanel" inherits="CombatMetrics_ControlFramed" virtual="true">
            <Controls>
                <Control name="$(parent)Headers">
                    <Anchor point="TOPLEFT" offsetY="2" />
                    <Anchor point="TOPRIGHT" offsetY="2" />
                    <Dimensions y="20" />
                    <Controls>
                        <Control name="$(parent)Icon">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Indicator" offsetX="2" />
                            <Dimensions x="20" y="20" />
                        </Control>

                        <Control name="$(parent)Name" inherits="CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Icon" offsetX="6" offsetY="0" />
                            <Dimensions x="178" />
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_TARGET), "name", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT)
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Fraction" inherits="CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Name" offsetX="2" offsetY="0" />
                            <Dimensions x="38" />
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_PERCENT), "fraction", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_CENTER)
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)PerSecond" inherits="CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Fraction" offsetX="2" offsetY="0" />
                            <Dimensions x="50" />
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_DPS), "perSecond", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_RIGHT)
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Total" inherits="CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)PerSecond" offsetX="2" offsetY="0" />
                            <Dimensions x="73" />
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_DAMAGE), "total", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_RIGHT)
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Crits" inherits="CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Total" offsetX="2" offsetY="0" />
                            <Dimensions x="42" />
                            <!-- <OnMouseUp> CMX.HitCritContextMenu(self, button)</OnMouseUp> TODO: integrate with sortheader -->
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_DAMAGE), "crits", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_RIGHT)
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Hits" inherits="CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Crits" offsetX="0" offsetY="0" />
                            <Dimensions x="42" />
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_PER_HITS), "hits", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_RIGHT)
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)CritRatio" inherits="CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Hits" offsetX="2" offsetY="0" />
                            <Dimensions x="35" />
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_CRITS_PER), "critRatio", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_RIGHT)
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Average" inherits="CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)CritRatio" offsetX="2" offsetY="0" />
                            <Dimensions x="50" />
                            <!-- <OnMouseUp> CMX.AverageContextMenu(self, button, "hitcrit")</OnMouseUp> TODO: integrate with sortheader-->
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_AVE), "averageHit", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_RIGHT)
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)MinMax" inherits="CombatMetrics_ValueFontControl CombatMetrics_LabelTooltip">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Average" offsetX="2" offsetY="0" />
                            <Dimensions x="50" />
                            <!-- <OnMouseUp> CMX.MinMaxContextMenu(self, button, "hitcrit")</OnMouseUp> TODO: integrate with sortheader -->
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_MAX), "minmax", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_RIGHT)
                            </OnInitialized>
                        </Control>
                    </Controls>
                </Control>

                <Line name="$(parent)Sep" color="SI_COMBAT_METRICS_SEP_COLOR" inherits="CombatMetrics_Line_Thin">
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)Headers" offsetY="2" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Headers" offsetY="2" />
                </Line>

                <Control name="$(parent)List" inherits="ZO_ScrollList">
                    <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$(parent)Sep" offsetY="2" />
                    <Anchor point="BOTTOMRIGHT" />
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>