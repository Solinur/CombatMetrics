<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sir.insidi.at/or/schema/esoui.xsd">
    <Controls>
        <Control name="CombatMetrics_ResourceListTemplate" virtual="true">
            <OnInitialized>
                local scrollList = GetControl(self, "PanelScrollChild")
                scrollList:SetResizeToFitPadding(0, 20)
            </OnInitialized>
            <Controls>
                <Control name="$(parent)Headers">
                    <Anchor point="TOPLEFT" offsetX="4" />
                    <Anchor point="TOPRIGHT" offsetX="-4" />
                    <Dimensions y="20" />
                    <Controls>
                        <Label name="$(parent)Name" inherits="CombatMetrics_ValueFontControl" text="SI_COMBAT_METRICS_REGENERATION"
                            horizontalAlignment="LEFT">
                            <Anchor point="BOTTOMLEFT" offsetX="0" offsetY="0" />
                            <Dimensions x="246" y="20" />
                        </Label>

                        <Label name="$(parent)Count" inherits="CombatMetrics_ValueFontControl CombatMetrics_LabelTooltip"
                            text="SI_COMBAT_METRICS_SHARP" horizontalAlignment="RIGHT">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Name" offsetX="4" offsetY="0" />
                            <Dimensions x="30" y="20" />
                            <OnInitialized>
                                self.tooltip = SI_COMBAT_METRICS_BUFFCOUNT_TT
                            </OnInitialized>
                        </Label>

                        <Label name="$(parent)Rate" inherits="CombatMetrics_ValueFontControl CombatMetrics_LabelTooltip"
                            text="SI_COMBAT_METRICS_PM_SEC" horizontalAlignment="RIGHT">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Count" offsetX="4" offsetY="0" />
                            <Dimensions x="50" y="20" />
                            <OnInitialized>
                                self.tooltip = SI_COMBAT_METRICS_UPTIME_TT
                            </OnInitialized>
                        </Label>
                    </Controls>
                </Control>

                <Line name="$(parent)Sep" color="SI_COMBAT_METRICS_SEP_COLOR" inherits="CombatMetrics_Line_Thin">
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)Header" offsetY="2" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Header" offsetY="2" />
                </Line>

                <Control name="$(parent)Panel" inherits="ZO_ScrollContainer">
                    <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$(parent)Sep" offsetX="0" offsetY="2" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-4" offsetY="-4" />
                </Control>
            </Controls>
        </Control>

        <Button name="CombatMetrics_BuffsPanelExpandButton" virtual="true" inherits="ZO_TreeButtonArrow" />

        <Control name="CombatMetrics_BuffsPanel" inherits="CombatMetrics_ControlFramed" virtual="true">
            <Controls>
                <Control name="$(parent)SearchBar">
                    <Anchor point="TOPLEFT" />
                    <Anchor point="TOPRIGHT" />
                    <Dimensions y="30" />

                    <Controls>
                        <Button name="$(parent)Enemy" inherits="CombatMetrics_ButtonTooltip" clickSound="Click">
                            <Anchor point="RIGHT" offsetX="-4" />
                            <Dimensions x="30" y="30" />
                            <OnInitialized>
                                self.tooltip = SI_COMBAT_METRICS_ENEMY
                                CombatMetrics.internal.InitializeBuffCategoryButton(self, "Enemy")
                            </OnInitialized>
                        </Button>

                        <Button name="$(parent)Group" inherits="CombatMetrics_ButtonTooltip" clickSound="Click">
                            <Anchor point="RIGHT" relativeTo="$(parent)Enemy" relativePoint="LEFT" offsetX="-4" />
                            <Dimensions x="30" y="30" />
                            <OnInitialized>
                                self.tooltip = SI_COMBAT_METRICS_GROUP
                                CombatMetrics.internal.InitializeBuffCategoryButton(self, "Group")
                            </OnInitialized>
                        </Button>

                        <Button name="$(parent)Player" inherits="CombatMetrics_ButtonTooltip" clickSound="Click">
                            <Anchor point="RIGHT" relativeTo="$(parent)Group" relativePoint="LEFT" offsetX="-4" />
                            <Dimensions x="30" y="30" />
                            <OnInitialized>
                                self.tooltip = SI_COMBAT_METRICS_PLAYER
                                CombatMetrics.internal.InitializeBuffCategoryButton(self, "Player")
                            </OnInitialized>
                        </Button>
                    </Controls>
                </Control>

                <Line name="$(parent)SearchBarSep" color="SI_COMBAT_METRICS_SEP_COLOR" inherits="CombatMetrics_Line_Thin">
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)SearchBar" offsetY="2" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)SearchBar" offsetY="2" />
                </Line>

                <Control name="$(parent)Headers">
                    <Anchor point="TOPLEFT" relativeTo="$(parent)SearchBarSep" offsetY="2" />
                    <Anchor point="TOPRIGHT" relativeTo="$(parent)SearchBarSep" offsetY="2" />
                    <Dimensions y="20" />
                    <Controls>
                        <Control name="$(parent)Indicator">
                            <Anchor point="LEFT" offsetX="2" />
                            <Dimensions x="10" y="10" />
                        </Control>

                        <Control name="$(parent)Icon">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Indicator" offsetX="2" />
                            <Dimensions x="20" y="20" />
                            <Controls>
                                <Texture name="$(parent)Texture" textureFile="esoui/art/miscellaneous/eso_icon_warning.dds"
                                    layer="CONTROLS" inherits="CombatMetrics_TextureTooltip" color="FFFF8800">
                                    <AnchorFill />
                                    <OnInitialized>
                                        self.tooltip = SI_COMBAT_METRICS_SIGIL_WARNING
                                    </OnInitialized>
                                </Texture>
                            </Controls>
                        </Control>

                        <Control name="$(parent)Name" inherits="CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Icon" offsetX="6" offsetY="0" />
                            <Dimensions x="170" />
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_BUFF), "name", ZO_SORT_ORDER_UP, TEXT_ALIGN_LEFT)
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Count" inherits="CombatMetrics_ControlTooltip CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Name" offsetX="4" offsetY="0" />
                            <Dimensions x="58" />
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_SHARP), "count", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_CENTER)
                                self.tooltip = SI_COMBAT_METRICS_BUFFCOUNT_TT
                            </OnInitialized>
                        </Control>

                        <Control name="$(parent)Uptime" inherits="CombatMetrics_ControlTooltip CombatMetrics_SortHeader">
                            <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Count" offsetX="2" offsetY="0" />
                            <Dimensions x="58" />
                            <OnInitialized>
                                ZO_SortHeader_Initialize(self, GetString(SI_COMBAT_METRICS_UPTIME),"uptime", ZO_SORT_ORDER_DOWN, TEXT_ALIGN_CENTER)
                                self.tooltip = SI_COMBAT_METRICS_UPTIME_TT
                            </OnInitialized>
                        </Control>
                    </Controls>
                </Control>

                <Line name="$(parent)Sep" color="SI_COMBAT_METRICS_SEP_COLOR" inherits="CombatMetrics_Line_Thin">
                    <Anchor point="BOTTOMLEFT" relativeTo="$(parent)Headers" offsetY="2" />
                    <Anchor point="BOTTOMRIGHT" relativeTo="$(parent)Headers" offsetY="2" />
                </Line>

                <Control name="$(parent)List" inherits="ZO_ScrollList">
                    <Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" relativeTo="$(parent)Sep" offsetY="2" />
                    <Anchor point="BOTTOMRIGHT" />
                </Control>
            </Controls>
        </Control>
    </Controls>
</GuiXml>