<GuiXml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sir.insidi.at/or/schema/esoui.xsd">
    <Controls>
        <Control name="CombatMetrics_LiveReport_Panel" virtual="true">
            <Anchor point="TOPLEFT" relativePoint="TOPLEFT" offsetX="2" offsetY="2" />
            <Dimensions x="150" y="26" />

            <Controls>
                <Texture name="$(parent)Icon" textureFile="/esoui/art/icons/mapkey/mapkey_fightersguild.dds">
                    <Anchor point="CENTER" relativePoint="LEFT" offsetX="12" />
                    <Dimensions x="24" y="24" />
                </Texture>

                <Label name="$(parent)Label" inherits="CombatMetrics_ValueFontSmallControl" text="0" horizontalAlignment="RIGHT"
                    verticalAlignment="CENTER">
                    <Anchor point="LEFT" relativePoint="RIGHT" relativeTo="$(parent)Icon" />
                    <Dimensions x="120" y="24" />
                </Label>

                <Control name="$(parent)Tooltip" inherits="CombatMetrics_ControlTooltip">
                    <Anchor point="TOPLEFT" offsetX="3" offsetY="3" />
                    <Anchor point="BOTTOMRIGHT" offsetX="-3" offsetY="-3" />
                    <OnMouseDown>CombatMetrics_LiveReport:StartMoving()</OnMouseDown>
                </Control>
            </Controls>
        </Control>

        <Control name="CombatMetrics_LiveReport_DamageOutSingle" inherits="CombatMetrics_LiveReport_Panel" virtual="true">
            <OnInitialized>CombatMetrics.internal.InitializeCombatStatsPanel(self, "dpsSingle")</OnInitialized>
        </Control>

        <Control name="CombatMetrics_LiveReport_DamageOut" inherits="CombatMetrics_LiveReport_Panel" virtual="true">
            <OnInitialized>CombatMetrics.internal.InitializeCombatStatsPanel(self, "dpsMulti")</OnInitialized>
        </Control>

        <Control name="CombatMetrics_LiveReport_HealOut" inherits="CombatMetrics_LiveReport_Panel" virtual="true">
            <OnInitialized>CombatMetrics.internal.InitializeCombatStatsPanel(self, "hpsOut")</OnInitialized>
        </Control>

        <Control name="CombatMetrics_LiveReport_HealOutAbsolute" inherits="CombatMetrics_LiveReport_Panel" virtual="true">
            <OnInitialized>CombatMetrics.internal.InitializeCombatStatsPanel(self, "hpsOutRaw")</OnInitialized>
        </Control>

        <Control name="CombatMetrics_LiveReport_DamageIn" inherits="CombatMetrics_LiveReport_Panel" virtual="true">
            <OnInitialized>CombatMetrics.internal.InitializeCombatStatsPanel(self, "dpsIn")</OnInitialized>
        </Control>

        <Control name="CombatMetrics_LiveReport_HealIn" inherits="CombatMetrics_LiveReport_Panel" virtual="true">
            <OnInitialized>CombatMetrics.internal.InitializeCombatStatsPanel(self, "hpsIn")</OnInitialized>
        </Control>

        <Control name="CombatMetrics_LiveReport_Time" inherits="CombatMetrics_LiveReport_Panel" virtual="true">
            <OnInitialized>CombatMetrics.internal.InitializeCombatStatsPanel(self, "time")</OnInitialized>
        </Control>

        <TopLevelControl name="CombatMetrics_LiveReport" clampedToScreen="true" movable="true" resizeToFitDescendents="true" hidden="true">
            <Anchor point="BOTTOM" relativePoint="BOTTOM" offsetY="-150" />
            <DimensionConstraints minX="150" maxX="900" minY="26" maxY="156" />
            <Controls>
                <Backdrop name="$(parent)BG" excludeFromResizeToFitExtents="true" inherits="CombatMetrics_BackgroundFramed_Solid"
                    edgeColor="FF000000" centerColor="FF000000">
                    <AnchorFill />
                </Backdrop>

                <Backdrop name="$(parent)ResizeFrame" excludeFromResizeToFitExtents="true" inherits="CombatMetrics_BackgroundFramed_Solid"
                    edgeColor="00000000" centerColor="00000000" mouseEnabled="true" resizeHandleSize="8">
                    <AnchorFill />
                    <DimensionConstraints minX="150" maxX="900" minY="26" maxY="156" />
                    <OnRectChanged>CombatMetrics.internal.NewSize(self, newLeft, newTop, newRight, newBottom, oldLeft, oldTop, oldRight, oldBottom)</OnRectChanged>
                    <OnResizeStart>CombatMetrics.internal.Resizing(self, true)</OnResizeStart>
                    <OnResizeStop>CombatMetrics.internal.Resizing(self, false)</OnResizeStop>
                    <OnMouseDown>CombatMetrics_LiveReport:StartMoving()</OnMouseDown>
                </Backdrop>
            </Controls>
        </TopLevelControl>
    </Controls>
</GuiXml>